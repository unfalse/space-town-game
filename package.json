{
  "name": "space-town-game",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "build": "yarn clear && yarn build:prod",
    "build:prod": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "build:types": "tsc --emitDeclarationOnly",
    "clear": "rimraf ./dist",
    "compile": "tsc",
    "lint": "eslint . --ext .ts",
    "prettier": "prettier",
    "server": "yarn build && yarn compile && node dist/server/index.js",
    "serverfast": "yarn build:dev && yarn compile && node dist/server/index.js",
    "server:dev": "yarn compile && node dist/server/index.js",
    "start": "webpack-dev-server --mode=development",
    "type-check": "tsc --noEmit",
    "watch": "webpack --watch",
    "devserver": "nodemon src/server/index.ts",
    "devclient": "nodemon --watch src --ignore src/server/index.ts --exec yarn server",
    "devboth": "nodemon -e ts --watch src/server/index.ts --watch src --ignore src/server/index.ts --exec yarn server",
    "dev": "nodemon -e ts,html,css --watch src --exec yarn serverfast --delay 5"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rollup-plugin-copy": "^3.5.0",
    "vite": "^8.0.8",
    "vite-plugin-html": "^3.2.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.8",
    "@types/express": "^4.17.9",
    "@types/node": "^14.14.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^4.14.0",
    "@typescript-eslint/parser": "^4.14.0",
    "@webpack-cli/serve": "^1.0.1",
    "clean-webpack-plugin": "^3.0.0",
    "copy-webpack-plugin": "^6.2.1",
    "eslint": "^7.18.0",
    "eslint-config-prettier": "^8.2.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-unicorn": "^27.0.0",
    "html-webpack-plugin": "^5",
    "nodemon": "^2.0.7",
    "prettier": "^2.2.1",
    "rimraf": "^3.0.2",
    "ts-loader": "^9",
    "ts-node": "^9.1.1",
    "typescript": "^6.0.3",
    "webpack": "^5.106.0",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  },
  "type": "module",
  "packageManager": "yarn@4.14.1"
}
