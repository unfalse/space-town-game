{
    "compilerOptions": {
        "declaration": true,
        // Ensure that Babel can safely transpile files in the TypeScript project
        "isolatedModules": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "jsx": "react-jsx",
        "resolveJsonModule": true,
        "outDir": "dist",
        "rootDir": "src",
        "esModuleInterop": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["node"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
